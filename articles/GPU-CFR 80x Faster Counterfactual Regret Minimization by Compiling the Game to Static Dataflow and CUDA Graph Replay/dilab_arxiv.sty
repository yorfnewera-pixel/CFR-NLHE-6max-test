\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{dilab_arxiv}[2026/08/06 DI-Lab arXiv preprint style]

% ==========================================
% 1. Core dependencies and typography
% ==========================================
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage[most]{tcolorbox}

% Release symbol definitions that conflict with XCharter/newtxmath.
\let\Bbbk\relax
\let\openbox\relax

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}

\RequirePackage{XCharter}
\RequirePackage[
  xcharter, 
  bigdelims, 
  vvarbb
]{newtxmath}
\RequirePackage{bm} % Load after newtxmath.
\newcommand{\me}{\mathrm{e}}
\newcommand{\mi}{\mathrm{i}}
\newcommand{\dif}{\mathop{}\!\mathrm{d}}
\RequirePackage[scaled=1.05]{zlmtt} 
\RequirePackage{microtype}

\RequirePackage{url}
\RequirePackage{booktabs}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{parskip}
\RequirePackage{fontawesome5} 
\RequirePackage{natbib}
\RequirePackage{caption}
\RequirePackage{titletoc}
\RequirePackage[explicit]{titlesec}

\RequirePackage{hyperref}

% Use parenthetical citations for the short \cite command.
\renewcommand{\cite}{\citep}

% ==========================================
% 2. Page layout and colors
% ==========================================
\geometry{
  letterpaper,
  top=1in,
  bottom=1in,
  left=1in,
  right=1in,
  headheight=15pt,
  headsep=0.15in
}

\definecolor{academicblue}{RGB}{25, 25, 112} 
\hypersetup{
    colorlinks=true,
    allcolors=academicblue,
}

% Figure and table captions.
\DeclareCaptionLabelSeparator{pipe}{ $\vert$ }
\captionsetup{labelfont={bf}, labelsep=pipe, font=small, singlelinecheck=off}

% ==========================================
% 3. Running header
% ==========================================
\newcommand{\@runningtitle}{}
\newcommand{\runningtitle}[1]{\renewcommand{\@runningtitle}{#1}}

\pagestyle{fancy}
\fancyhf{} 

\fancyhead[C]{%
  \ifnum\value{page}>1%
    \normalsize\bfseries 
    \ifx\@runningtitle\@empty \@title \else \@runningtitle \fi
    \vspace{-4pt}
  \fi
}
\fancyfoot[C]{\thepage}

\renewcommand{\headrulewidth}{0.8pt} 
\renewcommand{\headrule}{%
  \ifnum\value{page}>1%
    \vspace{-5pt}
    \hbox to\headwidth{\leaders\hrule height \headrulewidth\hfill}%
  \fi
}

\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% ==========================================
% 4. Title block
% ==========================================
\newcommand{\@paperlogo}{}
\newcommand{\paperlogo}[1]{\renewcommand{\@paperlogo}{#1}}

\def\@maketitle{%
  \newpage \null \vspace{-4.5em}
  {\fontfamily{cmr}\selectfont % 顶部保留原生字体的灵动斜体感
    \noindent
    \begin{minipage}[b]{0.5\textwidth}
      \raggedright 
      \setbox0=\hbox{\@paperlogo}%
      \ifdim\wd0=0pt {\Large \bfseries Decision Intelligence Lab} \else \usebox0 \fi
    \end{minipage}%
    \begin{minipage}[b]{0.5\textwidth}
      \raggedleft {\large \itshape \@date}
    \end{minipage}
    \par \vspace{0.1em}
    \hrule height 1pt \vspace{1.2em}
  }
  
  \begin{flushleft}
    {\fontsize{19}{23}\selectfont \bfseries \@title \par}
    {\large \bfseries \@author \par} 
  \end{flushleft}
  \vskip 1.0em
}

%==========================================
% 5. Abstract and section styling
% ==========================================
\renewenvironment{abstract}
  {
    \begin{tcolorbox}[
      enhanced,
      colback=gray!6,
      colframe=gray!20,
      arc=5pt,
      outer arc=5pt,
      boxrule=0.6pt,
      left=1.5em,
      right=1.5em,
      top=12pt,
      bottom=12pt,
      boxsep=0pt,
      before skip=1.5em,
      after skip=1.5em,
    ]
    \noindent
    {\bfseries \abstractname.} 
    \hspace{0.5em}\ignorespaces
  }
  {
    \end{tcolorbox}
  }

\titleformat{\section}{\large\bfseries}{\thesection.}{0.5em}{#1}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection.}{0.5em}{#1}
\titlespacing*{\section}{0pt}{2.5ex plus 1ex minus .2ex}{1.2ex plus .2ex}

% ==========================================
% 6. Optional appendix contents page
% ==========================================
\newcommand{\makeappendixtoc}{%
  \clearpage \vspace*{1em}
  \begin{flushleft} {\Large \bfseries Appendix} \end{flushleft}
  \vspace{1.5em} 
  \startcontents[sections]
  \normalsize \printcontents[sections]{l}{1}{\setcounter{tocdepth}{2}}
  \clearpage
}

\endinput
